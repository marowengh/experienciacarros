<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel de Administración - VISION 21</title>
  <link rel="stylesheet" href="/estilos/style.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    
    :root {
      --admin-navy: #1e293b;
      --admin-green: #65a30d;
      --admin-red: #ef4444;
      --admin-bg: #f8fafc;
      
      --surface-1: #ffffff;
      --surface-2: #f1f5f9;
      --border-color: rgba(0,0,0,0.1);
      --text-main: #0f172a;
      --text-muted: #64748b;
      --danger: #ef4444;
    }
    
    body {
      background-color: var(--admin-bg);
      color: var(--text-main);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      margin: 0;
      -webkit-font-smoothing: antialiased;
      background-image: 
        radial-gradient(circle at 15% 50%, rgba(101, 163, 13, 0.1), transparent 25%),
        radial-gradient(circle at 85% 30%, rgba(101, 163, 13, 0.1), transparent 25%);
      min-height: 100vh;
    }

    /* Override Inline Styles */
    .admin-header a[href="/"] { color: var(--text-main) !important; }
    .admin-header a[href="/api/logout"] { color: var(--danger) !important; }
    .admin-header > div > div { border-color: var(--border-color) !important; }
    .admin-header > div > div > div { background: var(--surface-2) !important; }
    
    .admin-container > div:first-of-type {
      background: linear-gradient(145deg, #ffffff, #f8fafc) !important;
      border: 1px solid var(--border-color);
      box-shadow: 0 20px 40px rgba(0,0,0,0.05) !important;
    }
    .admin-container > div:first-of-type > div:first-child {
      background: var(--surface-2) !important;
      color: var(--text-main) !important;
      border: 1px solid var(--border-color);
    }

    /* Header */
    .admin-header {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      padding: 16px 40px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .admin-container {
      max-width: 1300px;
      margin: 40px auto;
      padding: 0 24px;
    }

    .admin-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.05);
      padding: 32px;
      margin-bottom: 32px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .admin-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      letter-spacing: -0.5px;
    }

    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin-top: 10px;
    }

    th, td {
      padding: 16px 20px;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
    }

    th {
      background: rgba(0,0,0,0.02);
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
      font-size: 11px;
      letter-spacing: 1px;
    }

    td {
      color: var(--text-main);
      font-size: 14px;
      font-weight: 400;
    }

    tbody tr {
      transition: background 0.2s ease;
    }

    tbody tr:hover {
      background: rgba(0,0,0,0.02);
    }

    .badge {
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .badge-vip { background: rgba(101, 163, 13, 0.15); color: var(--admin-green); border: 1px solid rgba(101, 163, 13, 0.3); }
    .badge-eco { background: rgba(0, 0, 0, 0.05); color: var(--text-muted); border: 1px solid var(--border-color); }

    .btn-admin {
      padding: 10px 18px;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      font-size: 13px;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-add {
      background: var(--admin-navy);
      color: white;
      box-shadow: 0 4px 14px 0 rgba(0,0,0,0.1);
    }
    .btn-add:hover {
      background: #0f172a;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px 0 rgba(0,0,0,0.15);
    }

    .btn-edit {
      background: rgba(0,0,0,0.05);
      color: var(--text-main);
      border: 1px solid var(--border-color);
      margin-right: 8px;
    }
    .btn-edit:hover {
      background: rgba(0,0,0,0.1);
    }

    .btn-delete {
      background: rgba(239, 68, 68, 0.1);
      color: var(--danger);
      border: 1px solid rgba(239, 68, 68, 0.2);
    }
    .btn-delete:hover {
      background: rgba(239, 68, 68, 0.2);
    }

    /* Modal Styles */
    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      align-items: center;
      justify-content: center;
      z-index: 1000;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .modal.active {
      display: flex;
      opacity: 1;
    }
    .modal-content {
      background: var(--surface-1);
      border: 1px solid var(--border-color);
      padding: 40px;
      border-radius: 20px;
      width: 100%;
      max-width: 500px;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.15);
      transform: translateY(20px);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .modal.active .modal-content {
      transform: translateY(0);
    }

    .modal-title {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 24px;
      color: var(--text-main);
      letter-spacing: -0.5px;
    }
    .form-group {
      margin-bottom: 20px;
    }
    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-muted);
      margin-bottom: 8px;
    }
    .form-group input, .form-group select {
      width: 100%;
      padding: 12px 16px;
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      font-size: 14px;
      color: var(--text-main);
      transition: all 0.2s ease;
      box-sizing: border-box;
      box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    .form-group input:focus, .form-group select:focus {
      outline: none;
      border-color: var(--admin-green);
      background: rgba(178, 210, 53, 0.05);
      box-shadow: 0 0 0 3px rgba(178, 210, 53, 0.1);
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      margin-top: 32px;
    }

    .tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 30px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 10px;
    }
    .tab {
      padding: 8px 16px;
      cursor: pointer;
      font-weight: 500;
      color: var(--text-muted);
      border-radius: 8px;
      font-size: 14px;
      transition: all 0.2s ease;
    }
    .tab:hover {
      background: rgba(255,255,255,0.05);
      color: var(--text-main);
    }
    .tab.active {
      background: var(--text-main);
      color: var(--admin-bg);
      box-shadow: 0 2px 10px rgba(255,255,255,0.1);
    }

    .tab-content {
      display: none;
      animation: fadeIn 0.4s ease forwards;
    }
    .tab-content.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 24px;
      margin-top: 24px;
    }
    .dash-card {
      background: rgba(24, 24, 27, 0.4);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 24px;
      display: flex;
      align-items: center;
      gap: 20px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.2);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    .dash-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 100%; height: 2px;
      background: linear-gradient(90deg, transparent, var(--admin-green), transparent);
      opacity: 0;
      transition: opacity 0.3s;
    }
    .dash-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.5);
      border-color: rgba(255,255,255,0.2);
      background: rgba(24, 24, 27, 0.7);
    }
    .dash-card:hover::before {
      opacity: 1;
    }

    .dash-icon {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.1);
    }
    .dash-info {
      flex: 1;
    }
    .dash-val {
      font-size: 28px;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.2;
      letter-spacing: -0.5px;
    }
    .dash-label {
      font-size: 13px;
      color: var(--text-muted);
      font-weight: 500;
      margin-top: 4px;
    }

    /* Override dash icons to look better in dark mode */
    .dash-icon svg { width: 28px; height: 28px; }
    .dash-card:nth-child(1) .dash-icon { background: rgba(2, 132, 199, 0.2) !important; color: #38bdf8 !important; }
    .dash-card:nth-child(2) .dash-icon { background: rgba(22, 163, 74, 0.2) !important; color: #4ade80 !important; }
    .dash-card:nth-child(3) .dash-icon { background: rgba(202, 138, 4, 0.2) !important; color: #facc15 !important; }
    .dash-card:nth-child(4) .dash-icon { background: rgba(147, 51, 234, 0.2) !important; color: #c084fc !important; }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--admin-bg); }
    ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #52525b; }
  </style>
</head>
<body>

<header class="admin-header">
  <a href="/" style="font-weight: 800; font-size: 20px; color: var(--admin-navy); text-decoration: none;">
    VISION<span style="color:#B2D235;">21</span> <span style="font-size: 14px; color: #64748b; font-weight: normal; margin-left: 10px;">| Panel Admin</span>
  </a>
  <div style="display: flex; align-items: center; gap: 15px;">
    <% if (locals.usuario) { %>
      <div style="display: flex; align-items: center; gap: 10px; border-right: 2px solid #e2e8f0; padding-right: 15px;">
        <div style="width: 32px; height: 32px; border-radius: 50%; background: #0f172a; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold;">
          <%= locals.usuario.nombre.charAt(0).toUpperCase() %>
        </div>
        <span style="font-size: 14px; font-weight: 600;"><%= locals.usuario.nombre %></span>
      </div>
    <% } %>
    <a href="/api/logout" style="color: var(--admin-red); font-size: 14px; font-weight: 600; text-decoration: none;">Cerrar Sesión</a>
  </div>
</header>

<div class="admin-container">

  <!-- Profile Header Aligned with perfil.ejs -->
  <div style="background: linear-gradient(135deg, var(--admin-navy), #1e293b); padding: 40px 30px; border-radius: 16px; color: white; margin-bottom: 30px; display: flex; align-items: center; gap: 25px; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
    <div style="width: 100px; height: 100px; background: #fff; border-radius: 50%; color: var(--admin-navy); display: flex; align-items: center; justify-content: center; font-size: 40px; font-weight: bold; flex-shrink: 0; box-shadow: 0 4px 10px rgba(0,0,0,0.1); overflow: hidden;">
      <% if(locals.usuario && locals.usuario.foto) { %>
        <img src="<%= locals.usuario.foto %>" alt="Foto" style="width: 100%; height: 100%; object-fit: cover;">
      <% } else if(locals.usuario) { %>
        <%= locals.usuario.nombre.charAt(0).toUpperCase() %>
      <% } else { %>
        A
      <% } %>
    </div>
    <div>
      <h1 style="margin: 0 0 5px 0; font-size: 28px; font-weight: 800;">
        <% if(locals.usuario) { %><%= locals.usuario.nombre %> <%= locals.usuario.apellidos %><% } else { %>Administrador<% } %>
      </h1>
      <p style="margin: 0 0 10px 0; color: #cbd5e1; font-size: 15px;">
        <% if(locals.usuario) { %><%= locals.usuario.email %><% } else { %>admin@vision21.com<% } %>
      </p>
      <span style="display: inline-block; background: var(--admin-green); color: #fff; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase;">
        Perfil Administrador
      </span>
    </div>
  </div>

  
  <div class="dashboard-grid" style="margin-top: 0; margin-bottom: 30px;">
      <div class="dash-card">
        <div class="dash-icon" style="background:#e0f2fe; color:#0284c7;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </div>
        <div class="dash-info">
          <div class="dash-val" id="dash-usuarios">...</div>
          <div class="dash-label">Usuarios Registrados</div>
        </div>
      </div>
      <div class="dash-card">
        <div class="dash-icon" style="background:#dcfce7; color:#16a34a;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
        </div>
        <div class="dash-info">
          <div class="dash-val" id="dash-reservas">...</div>
          <div class="dash-label">Reservas Totales</div>
        </div>
      </div>
      <div class="dash-card">
        <div class="dash-icon" style="background:#fef9c3; color:#ca8a04;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon><line x1="9" y1="3" x2="9" y2="18"></line><line x1="15" y1="6" x2="15" y2="21"></line></svg>
        </div>
        <div class="dash-info">
          <div class="dash-val" id="dash-viajes">...</div>
          <div class="dash-label">Viajes Programados</div>
        </div>
      </div>
      <div class="dash-card">
        <div class="dash-icon" style="background:#f3e8ff; color:#9333ea;">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </div>
        <div class="dash-info">
          <div class="dash-val" id="dash-ingresos">...</div>
          <div class="dash-label">Ingresos Estimados</div>
        </div>
      </div>
  </div>

  <div class="tabs">
    <div class="tab active" onclick="switchTab('viajes')">Gestión de Horarios</div>
    <div class="tab" onclick="switchTab('destinos')">Destinos Turísticos</div>
    <div class="tab" onclick="switchTab('reservas')">Control de Reservas</div>
    <div class="tab" onclick="switchTab('usuarios')">Directorio de Usuarios</div>
  </div>

  <div class="admin-card tab-content" id="tab-destinos">
    <div class="admin-title">
      Destinos Turísticos
      <button class="btn-admin btn-add" onclick="openDestinoModal('add')">+ Nuevo Destino</button>
    </div>
    <div style="overflow-x: auto;">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Tiempo</th>
            <th>Frecuencia</th>
            <th>Precio Base</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="destinos-tbody">
          <tr><td colspan="7" style="text-align:center;"></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="admin-card tab-content active" id="tab-viajes">
    <div class="admin-title">
      Gestión de Horarios y Buses
      <button class="btn-admin btn-add" onclick="openModal('add')">+ Nuevo Horario</button>
    </div>
    
    <div style="overflow-x: auto;">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Ruta</th>
            <th>Horario</th>
            <th>Servicio</th>
            <th>Modelo Bus</th>
            <th>Precio</th>
            <th>Asientos Disp.</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="viajes-tbody">
          <tr><td colspan="8" style="text-align:center;"></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="admin-card tab-content" id="tab-reservas">
    <div class="admin-title">
      Reservas Recientes
    </div>
    
    <div style="overflow-x: auto;">
      <table>
        <thead>
          <tr>
            <th>Boleto</th>
            <th>Fecha Compra</th>
            <th>Cliente</th>
            <th>Viaje</th>
            <th>Pasajeros</th>
            <th>Ubicación</th>
            <th>Total Pago</th>
            <th>Método / Estado</th>
            <th>N° Operación</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="reservas-tbody">
          <tr><td colspan="8" style="text-align:center;"></td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="admin-card tab-content" id="tab-usuarios">
    <div class="admin-title">
      Directorio de Usuarios
      <button class="btn-admin btn-add" onclick="openUsuarioModal('add')">+ Nuevo Usuario</button>
    </div>
    <div style="overflow-x: auto;">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre Completo</th>
            <th>Email</th>
            <th>Teléfono</th>
            <th>Rol</th>
            <th>Fecha Registro</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="usuarios-tbody">
          <tr><td colspan="6" style="text-align:center;"></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>



<!-- Modal para Crear/Editar Destino -->
<div class="modal" id="destinoModal">
  <div class="modal-content">
    <div class="modal-title" id="destinoModalTitle">Nuevo Destino</div>
    <form id="destinoForm">
      <input type="hidden" id="destino_id">
      <div class="form-group">
        <label>Nombre del Destino</label>
        <input type="text" id="dest_nombre" required>
      </div>
      <div class="form-group">
        <label>Descripción</label>
        <input type="text" id="dest_descripcion" required>
      </div>
      <div style="display: flex; gap: 15px;">
        <div class="form-group" style="flex: 1;">
          <label>Tiempo de Viaje</label>
          <input type="text" id="dest_tiempo" placeholder="Ej: 5h 30m" required>
        </div>
        <div class="form-group" style="flex: 1;">
          <label>Frecuencia de Salidas</label>
          <input type="text" id="dest_frecuencia" placeholder="Ej: Diario" required>
        </div>
      </div>
      <div style="display: flex; gap: 15px;">
        <div class="form-group" style="flex: 1;">
          <label>Precio Base (S/)</label>
          <input type="number" id="dest_precio" step="0.10" required>
        </div>
        <div class="form-group" style="flex: 1;">
          <label>Clase CSS de Imagen</label>
          <input type="text" id="dest_imagen" value="default-photo" required>
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-admin" style="background: #e2e8f0;" onclick="closeDestinoModal()">Cancelar</button>
        <button type="submit" class="btn-admin btn-add">Guardar</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal para Crear/Editar Usuario -->
<div class="modal" id="usuarioModal">
  <div class="modal-content">
    <div class="modal-title" id="usuarioModalTitle">Nuevo Usuario</div>
    <form id="usuarioForm">
      <input type="hidden" id="usuario_id">
      <div style="display: flex; gap: 15px;">
        <div class="form-group" style="flex: 1;">
          <label>Nombre</label>
          <input type="text" id="usr_nombre" required>
        </div>
        <div class="form-group" style="flex: 1;">
          <label>Apellidos</label>
          <input type="text" id="usr_apellidos" required>
        </div>
      </div>
      <div style="display: flex; gap: 15px;">
        <div class="form-group" style="flex: 1;">
          <label>Email</label>
          <input type="email" id="usr_email" required>
        </div>
        <div class="form-group" style="flex: 1;">
          <label>Rol</label>
          <select id="usr_rol">
            <option value="user">Usuario</option>
            <option value="admin">Administrador</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>Teléfono</label>
        <input type="tel" id="usr_telefono" pattern="[0-9]{9}" minlength="9" maxlength="9" title="Debe contener exactamente 9 dígitos numéricos" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
      </div>
      <div class="form-group">
        <label>Contraseña (Dejar en blanco si no se cambia)</label>
        <input type="password" id="usr_password">
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-admin" style="background: #e2e8f0;" onclick="closeUsuarioModal()">Cancelar</button>
        <button type="submit" class="btn-admin btn-add">Guardar</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal para Editar Reserva -->
<div class="modal" id="reservaModal">
  <div class="modal-content">
    <div class="modal-title">Editar Reserva</div>
    <form id="reservaForm">
      <input type="hidden" id="reserva_id">
      <div class="form-group">
        <label>Nombre del Cliente</label>
        <input type="text" id="res_cliente" required>
      </div>
      <div class="form-group">
        <label>Documento de Identidad</label>
        <input type="text" id="res_documento" required>
      </div>
      <div style="display: flex; gap: 15px;">
        <div class="form-group" style="flex: 1;">
          <label>Cantidad Pasajeros</label>
          <input type="number" id="res_cantidad" required>
        </div>
        <div class="form-group" style="flex: 1;">
          <label>Ubicación</label>
          <input type="text" id="res_ubicacion">
        </div>
      </div>
      <div style="display: flex; gap: 15px;">
        <div class="form-group" style="flex: 1;">
          <label>Fecha del Viaje</label>
          <input type="date" id="res_fecha" required>
        </div>
        <div class="form-group" style="flex: 1;">
          <label>Precio Total Manual (S/)</label>
          <input type="number" step="0.01" id="res_precio_manual" placeholder="Calculado auto.">
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-admin" style="background: #e2e8f0;" onclick="closeReservaModal()">Cancelar</button>
        <button type="submit" class="btn-admin btn-add">Guardar</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal para Crear/Editar -->
<div class="modal" id="viajeModal">
  <div class="modal-content">
    <div class="modal-title" id="modalTitle">Nuevo Horario</div>
    <form id="viajeForm">
      <input type="hidden" id="viaje_id">
      
      <div style="display: flex; gap: 15px;">
        <div class="form-group" style="flex: 1;">
          <label>Origen</label>
          <input type="text" id="origen" value="Ayacucho" required>
        </div>
        <div class="form-group" style="flex: 1;">
          <label>Destino</label>
          <input type="text" id="destino" required>
        </div>
      </div>
      
      <div style="display: flex; gap: 15px;">
        <div class="form-group" style="flex: 1;">
          <label>Hora Salida (Ej: 08:30 AM)</label>
          <input type="text" id="hora_salida" required>
        </div>
        <div class="form-group" style="flex: 1;">
          <label>Hora Llegada</label>
          <input type="text" id="hora_llegada" required>
        </div>
      </div>
      
      <div style="display: flex; gap: 15px;">
        <div class="form-group" style="flex: 1;">
          <label>Tipo de Servicio</label>
          <select id="servicio" required>
            <option value="Económico">Económico</option>
            <option value="Cama 160°">Cama 160°</option>
            <option value="Servicio VIP">Servicio VIP</option>
          </select>
        </div>
        <div class="form-group" style="flex: 1;">
          <label>Modelo del Carro</label>
          <input type="text" id="modelo_carro" placeholder="Ej: Mercedes Sprinter" required>
        </div>
      </div>
      
      <div style="display: flex; gap: 15px;">
        <div class="form-group" style="flex: 1;">
          <label>Precio (S/)</label>
          <input type="number" id="precio" step="0.10" required>
        </div>
        <div class="form-group" style="flex: 1;">
          <label>Asientos Totales</label>
          <input type="number" id="asientos_totales" value="40" required>
        </div>
        <div class="form-group" style="flex: 1;">
          <label>Asientos Disponibles</label>
          <input type="number" id="asientos_disponibles" value="40" required>
        </div>
      </div>
      
      <div class="modal-actions">
        <button type="button" class="btn-admin" style="background: #e2e8f0;" onclick="closeModal()">Cancelar</button>
        <button type="submit" class="btn-admin btn-add">Guardar</button>
      </div>
    </form>
  </div>
</div>


<script>
  let currentViajes = [];
  let currentReservas = [];
  let currentDestinos = [];
  let currentUsuarios = [];

  function switchTab(tabId) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));
    
    const tabEl = document.querySelector(`.tab[onclick="switchTab('${tabId}')"]`);
    if (tabEl) tabEl.classList.add('active');
    
    const contentEl = document.getElementById(`tab-${tabId}`);
    if (contentEl) contentEl.classList.add('active');

    if (tabId === 'viajes') loadViajes();
    if (tabId === 'reservas') loadReservas();
    if (tabId === 'destinos') loadDestinos();
    if (tabId === 'usuarios') loadUsuarios();
  }

  async function loadDashboard() {
    try {
      const [resUsers, resReservas, resViajes] = await Promise.all([
        fetch('/api/admin/usuarios').then(r=>r.json()),
        fetch('/api/admin/reservas').then(r=>r.json()),
        fetch('/api/admin/viajes').then(r=>r.json())
      ]);
      document.getElementById('dash-usuarios').textContent = resUsers.length || 0;
      document.getElementById('dash-reservas').textContent = resReservas.length || 0;
      document.getElementById('dash-viajes').textContent = resViajes.length || 0;
      
      const ingresos = (resReservas || []).reduce((sum, r) => sum + (r.cantidad_pasajeros * parseFloat(r.precio || 0)), 0);
      document.getElementById('dash-ingresos').textContent = 'S/ ' + ingresos.toFixed(2);
    } catch(e) {
      console.error('Error cargando dashboard', e);
    }
  }

  // Cargar dashboard y la primera pestaña por defecto
  window.addEventListener('DOMContentLoaded', () => {
    loadDashboard();
    switchTab('viajes');
  });

  // --- VIAJES ---
  async function loadViajes() {
    try {
      const res = await fetch('/api/admin/viajes');
      const data = await res.json();
      currentViajes = data;
      renderTable(data);
    } catch (e) {
      document.getElementById('viajes-tbody').innerHTML = '<tr><td colspan="8" style="color:red;text-align:center;">Error cargando datos</td></tr>';
    }
  }

  function renderTable(viajes) {
    const tbody = document.getElementById('viajes-tbody');
    if (viajes.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;">No hay viajes registrados</td></tr>';
      return;
    }
    tbody.innerHTML = viajes.map(v => {
      const isVIP = v.servicio.toLowerCase().includes('vip');
      return `
        <tr>
          <td>#${v.id}</td>
          <td><strong>${v.origen}</strong> a <strong>${v.destino}</strong></td>
          <td>${v.hora_salida} - ${v.hora_llegada}</td>
          <td><span class="badge ${isVIP ? 'badge-vip' : 'badge-eco'}">${v.servicio}</span></td>
          <td>${v.modelo_carro || '-'}</td>
          <td style="font-weight:bold; color:var(--admin-navy);">S/ ${parseFloat(v.precio).toFixed(2)}</td>
          <td>${v.asientos_disponibles} / ${v.asientos_totales}</td>
          <td>
            <button class="btn-admin btn-edit" onclick="openModal('edit', ${v.id})">Editar</button>
            <button class="btn-admin btn-delete" onclick="deleteViaje(${v.id})">Eliminar</button>
          </td>
        </tr>
      `;
    }).join('');
  }

  let isEditingViaje = false;
  function openModal(mode, id = null) {
    isEditingViaje = (mode === 'edit');
    document.getElementById('modalTitle').textContent = isEditingViaje ? 'Editar Horario' : 'Nuevo Horario';
    if (isEditingViaje) {
      const viaje = currentViajes.find(v => v.id === id);
      document.getElementById('viaje_id').value = viaje.id;
      document.getElementById('origen').value = viaje.origen;
      document.getElementById('destino').value = viaje.destino;
      document.getElementById('hora_salida').value = viaje.hora_salida;
      document.getElementById('hora_llegada').value = viaje.hora_llegada;
      document.getElementById('servicio').value = viaje.servicio;
      document.getElementById('modelo_carro').value = viaje.modelo_carro;
      document.getElementById('precio').value = viaje.precio;
      document.getElementById('asientos_totales').value = viaje.asientos_totales;
      document.getElementById('asientos_disponibles').value = viaje.asientos_disponibles;
    } else {
      document.getElementById('viajeForm').reset();
      document.getElementById('origen').value = 'Ayacucho';
      document.getElementById('viaje_id').value = '';
    }
    document.getElementById('viajeModal').classList.add('active');
  }

  function closeModal() { document.getElementById('viajeModal').classList.remove('active'); }

  document.getElementById('viajeForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = {
      origen: document.getElementById('origen').value,
      destino: document.getElementById('destino').value,
      hora_salida: document.getElementById('hora_salida').value,
      hora_llegada: document.getElementById('hora_llegada').value,
      servicio: document.getElementById('servicio').value,
      modelo_carro: document.getElementById('modelo_carro').value,
      precio: document.getElementById('precio').value,
      asientos_totales: document.getElementById('asientos_totales').value,
      asientos_disponibles: document.getElementById('asientos_disponibles').value
    };
    const id = document.getElementById('viaje_id').value;
    const url = isEditingViaje ? `/api/admin/viajes/${id}` : '/api/admin/viajes';
    const method = isEditingViaje ? 'PUT' : 'POST';
    
    const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    const result = await res.json();
    if (result.success) { closeModal(); loadViajes(); } else { alert(result.error); }
  });

  async function deleteViaje(id) {
    if (confirm('¿Eliminar este horario?')) {
      const res = await fetch(`/api/admin/viajes/${id}`, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) loadViajes(); else alert(result.error);
    }
  }

  // --- RESERVAS ---
  async function loadReservas() {
    try {
      const res = await fetch('/api/admin/reservas');
      const data = await res.json();
      currentReservas = data;
      renderReservasTable(data);
    } catch (e) {
      document.getElementById('reservas-tbody').innerHTML = '<tr><td colspan="8" style="color:red;text-align:center;">Error cargando reservas</td></tr>';
    }
  }

  function renderReservasTable(reservas) {
    const tbody = document.getElementById('reservas-tbody');
    if (reservas.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;">No hay reservas registradas</td></tr>';
      return;
    }
    tbody.innerHTML = reservas.map(r => {
      const fechaViaje = new Date(r.fecha_viaje).toISOString().split('T')[0];
      const fechaCompra = new Date(r.fecha_creacion).toLocaleString('es-PE', { dateStyle: 'short', timeStyle: 'short' });
      const total = r.precio_manual !== null && r.precio_manual !== undefined ? parseFloat(r.precio_manual) : r.cantidad_pasajeros * parseFloat(r.precio);
      return `
        <tr>
          <td><strong>${r.codigo_boleto}</strong></td>
          <td>${fechaCompra}</td>
          <td>${r.cliente_nombre}<br><small style="color:#64748b;">Doc: ${r.cliente_documento}</small></td>
          <td>${r.origen} a ${r.destino}<br><small style="color:#64748b;">${fechaViaje} | ${r.hora_salida}</small></td>
          <td>${r.cantidad_pasajeros} Persona(s)</td>
          <td><span class="badge" style="background:#f1f5f9;color:#334155;">${r.ubicacion || 'Atrás'}</span></td>
          <td style="font-weight:bold; color:var(--admin-green);">S/ ${total.toFixed(2)}</td>
          <td>${r.metodo_pago || 'Transferencia'}<br><small style="color:${r.estado_pago === 'Pendiente Validación' ? '#ca8a04' : '#64748b'};">${r.estado_pago || 'Pagado'}</small></td>
          <td>${r.numero_operacion || '-'}</td>
          <td>
            <button class="btn-admin" style="background:#ca8a04;color:white;margin-bottom:4px;display:block;" onclick="generarComprobante('${r.codigo_boleto}', '${r.cliente_nombre}', '${r.cliente_documento}', '${r.origen}', '${r.destino}', '${fechaViaje}', '${total.toFixed(2)}')">Detalles</button>
            <button class="btn-admin btn-edit" style="margin-bottom:4px;" onclick="openReservaModal(${r.id})">Editar</button>
            <button class="btn-admin btn-delete" style="margin-bottom:4px;" onclick="deleteReserva(${r.id})">Eliminar</button>
          </td>
        </tr>
      `;
    }).join('');
  }

  function openReservaModal(id) {
    const res = currentReservas.find(r => r.id === id);
    document.getElementById('reserva_id').value = res.id;
    document.getElementById('res_cliente').value = res.cliente_nombre;
    document.getElementById('res_documento').value = res.cliente_documento;
    document.getElementById('res_cantidad').value = res.cantidad_pasajeros;
    document.getElementById('res_ubicacion').value = res.ubicacion;
    document.getElementById('res_precio_manual').value = res.precio_manual || '';
    document.getElementById('res_fecha').value = new Date(res.fecha_viaje).toISOString().split('T')[0];
    document.getElementById('reservaModal').classList.add('active');
  }

  function closeReservaModal() { document.getElementById('reservaModal').classList.remove('active'); }

  document.getElementById('reservaForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('reserva_id').value;
    const payload = {
      cliente_nombre: document.getElementById('res_cliente').value,
      cliente_documento: document.getElementById('res_documento').value,
      cantidad_pasajeros: document.getElementById('res_cantidad').value,
      ubicacion: document.getElementById('res_ubicacion').value,
      fecha_viaje: document.getElementById('res_fecha').value,
      precio_manual: document.getElementById('res_precio_manual').value
    };
    const res = await fetch(`/api/admin/reservas/${id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    const result = await res.json();
    if (result.success) { closeReservaModal(); loadReservas(); } else { alert(result.error); }
  });

  async function deleteReserva(id) {
    if (confirm('¿Eliminar esta reserva?')) {
      const res = await fetch(`/api/admin/reservas/${id}`, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) loadReservas(); else alert(result.error);
    }
  }

  function verDetallesReserva(id) {
    const r = currentReservas.find(x => x.id === id);
    if(r) {
      alert(`Detalles de Reserva:\n\nCódigo: ${r.codigo_boleto}\nCliente: ${r.cliente_nombre}\nDocumento: ${r.cliente_documento}\nViaje: ${r.origen} a ${r.destino}\nFecha Viaje: ${new Date(r.fecha_viaje).toISOString().split('T')[0]}\nPasajeros: ${r.cantidad_pasajeros}\nUbicación: ${r.ubicacion || 'N/A'}\nServicio: ${r.servicio || 'N/A'}`);
    }
  }

  function generarComprobante(codigo, nombre, doc, origen, destino, fecha, total) {
    const printWindow = window.open('', '_blank', 'width=800,height=600');
    printWindow.document.write(`
      <html>
      <head>
        <title>Comprobante - ${codigo}</title>
        <style>
          body { font-family: 'Inter', sans-serif; padding: 40px; color: #1e293b; background: #f8fafc; }
          .comprobante { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 40px; max-width: 650px; margin: 0 auto; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
          .header { text-align: center; border-bottom: 2px dashed #cbd5e1; padding-bottom: 25px; margin-bottom: 30px; }
          .header h2 { margin: 0; color: #0f172a; font-size: 28px; font-weight: 900; letter-spacing: -0.5px; }
          .header h2 span { color: #B2D235; }
          .header p { margin: 8px 0 0 0; color: #64748b; font-size: 15px; font-weight: 500; }
          .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
          .info-box { background: #f8fafc; padding: 15px; border-radius: 8px; border: 1px solid #f1f5f9; }
          .label { display: block; font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; margin-bottom: 5px; }
          .value { font-size: 15px; font-weight: 700; color: #0f172a; }
          .total-box { background: #0f172a; color: white; padding: 20px; border-radius: 12px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
          .total-label { font-size: 16px; font-weight: 600; color: #cbd5e1; }
          .total-value { font-size: 24px; font-weight: 800; color: #B2D235; }
          .footer { text-align: center; padding-top: 25px; border-top: 1px solid #e2e8f0; }
          .footer p { margin: 0 0 10px 0; font-size: 14px; color: #475569; font-weight: 500; }
          .contact { display: inline-block; background: #e0f2fe; color: #0284c7; padding: 8px 16px; border-radius: 20px; font-size: 13px; font-weight: 600; text-decoration: none; }
          .print-btn { display: inline-block; margin-top: 20px; padding: 12px 24px; background: #B2D235; color: #0f172a; font-weight: 700; border: none; border-radius: 8px; cursor: pointer; transition: 0.2s; font-size: 15px; }
          .print-btn:hover { background: #a3c323; }
          @media print { 
            body { padding: 0; background: white; } 
            .comprobante { box-shadow: none; border: none; padding: 0; } 
            .print-btn { display: none; }
          }
        </style>
      </head>
      <body>
        <div class="comprobante">
          <div class="header">
            <h2>VISION<span>21</span></h2>
            <p>Comprobante de Pago Electrónico</p>
          </div>
          
          <div class="info-grid">
            <div class="info-box">
              <span class="label">Boleto Nro</span>
              <span class="value">${codigo}</span>
            </div>
            <div class="info-box">
              <span class="label">Fecha de Viaje</span>
              <span class="value">${fecha}</span>
            </div>
            <div class="info-box">
              <span class="label">Pasajero</span>
              <span class="value">${nombre}</span>
            </div>
            <div class="info-box">
              <span class="label">Documento</span>
              <span class="value">${doc}</span>
            </div>
            <div class="info-box" style="grid-column: span 2;">
              <span class="label">Ruta</span>
              <span class="value" style="font-size: 18px;">${origen} &rarr; ${destino}</span>
            </div>
          </div>
          
          <div class="total-box">
            <span class="total-label">Total Pagado</span>
            <span class="total-value">S/ ${total}</span>
          </div>
          
          <div class="footer">
            <p>¡Gracias por viajar con nosotros!</p>
            <p style="font-size: 13px; color: #94a3b8; margin-bottom: 15px;">Para consultas o reprogramaciones, comunícate con nuestro soporte.</p>
            <a href="https://wa.me/51999999999" target="_blank" class="contact">📞 Soporte WhatsApp: +51 999 999 999</a>
            <br>
            <button class="print-btn" onclick="window.print()">🖨️ Imprimir Comprobante</button>
          </div>
        </div>
      </body>
      </html>
    `);
    printWindow.document.close();
  }



  // --- DESTINOS ---
  async function loadDestinos() {
    try {
      const res = await fetch('/api/destinos');
      const data = await res.json();
      currentDestinos = data;
      renderDestinosTable(data);
    } catch (e) {
      document.getElementById('destinos-tbody').innerHTML = '<tr><td colspan="7" style="color:red;text-align:center;">Error cargando destinos</td></tr>';
    }
  }

  function renderDestinosTable(destinos) {
    const tbody = document.getElementById('destinos-tbody');
    if (!destinos || destinos.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;">No hay destinos registrados</td></tr>';
      return;
    }
    tbody.innerHTML = destinos.map(d => `
        <tr>
          <td>#${d.id}</td>
          <td><strong>${d.nombre || ''}</strong></td>
          <td>${(d.descripcion || '').substring(0,30)}...</td>
          <td>${d.tiempo_viaje || ''}</td>
          <td>${d.frecuencia_salidas || ''}</td>
          <td style="font-weight:bold; color:var(--admin-navy);">S/ ${parseFloat(d.precio_base || 0).toFixed(2)}</td>
          <td>
            <button class="btn-admin btn-edit" onclick="openDestinoModal('edit', ${d.id})">Editar</button>
            <button class="btn-admin btn-delete" onclick="deleteDestino(${d.id})">Eliminar</button>
          </td>
        </tr>
      `).join('');
  }

  let isEditingDestino = false;
  function openDestinoModal(mode, id = null) {
    isEditingDestino = (mode === 'edit');
    document.getElementById('destinoModalTitle').textContent = isEditingDestino ? 'Editar Destino' : 'Nuevo Destino';
    if (isEditingDestino) {
      const dest = currentDestinos.find(d => d.id === id);
      document.getElementById('destino_id').value = dest.id;
      document.getElementById('dest_nombre').value = dest.nombre || '';
      document.getElementById('dest_descripcion').value = dest.descripcion || '';
      document.getElementById('dest_tiempo').value = dest.tiempo_viaje || '';
      document.getElementById('dest_frecuencia').value = dest.frecuencia_salidas || '';
      document.getElementById('dest_precio').value = dest.precio_base || '';
      document.getElementById('dest_imagen').value = dest.clase_imagen || 'default-photo';
    } else {
      document.getElementById('destinoForm').reset();
      document.getElementById('destino_id').value = '';
    }
    document.getElementById('destinoModal').classList.add('active');
  }

  function closeDestinoModal() { document.getElementById('destinoModal').classList.remove('active'); }

  document.getElementById('destinoForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = {
      nombre: document.getElementById('dest_nombre').value,
      descripcion: document.getElementById('dest_descripcion').value,
      tiempo_viaje: document.getElementById('dest_tiempo').value,
      frecuencia_salidas: document.getElementById('dest_frecuencia').value,
      precio_base: document.getElementById('dest_precio').value,
      clase_imagen: document.getElementById('dest_imagen').value
    };
    const id = document.getElementById('destino_id').value;
    const url = isEditingDestino ? `/api/admin/destinos/${id}` : '/api/admin/destinos';
    const method = isEditingDestino ? 'PUT' : 'POST';
    
    const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    const result = await res.json();
    if (result.success) { closeDestinoModal(); loadDestinos(); } else { alert(result.error || 'Error del servidor'); }
  });

  async function deleteDestino(id) {
    if (confirm('¿Eliminar este destino? (Asegúrate de no tener viajes asociados)')) {
      const res = await fetch(`/api/admin/destinos/${id}`, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) loadDestinos(); else alert(result.error);
    }
  }

  // --- USUARIOS ---
  async function loadUsuarios() {
    try {
      const res = await fetch('/api/admin/usuarios');
      const data = await res.json();
      currentUsuarios = data;
      renderUsuariosTable(data);
    } catch (e) {
      document.getElementById('usuarios-tbody').innerHTML = '<tr><td colspan="6" style="color:red;text-align:center;">Error cargando usuarios</td></tr>';
    }
  }

  function renderUsuariosTable(usuarios) {
    const tbody = document.getElementById('usuarios-tbody');
    if (usuarios.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">No hay usuarios registrados</td></tr>';
      return;
    }
    tbody.innerHTML = usuarios.map(u => {
      const fechaReg = new Date(u.fecha_registro).toLocaleDateString('es-PE');
      const rolBadge = u.rol === 'admin' ? '<span class="badge badge-vip" style="background:#ca8a04;color:white;border:none;">Admin</span>' : '<span class="badge badge-eco">Usuario</span>';
      return `
        <tr>
          <td>#${u.id}</td>
          <td><strong>${u.nombre} ${u.apellidos}</strong></td>
          <td>${u.email}</td>
          <td>${u.telefono || '-'}</td>
          <td>${rolBadge}</td>
          <td>${fechaReg}</td>
          <td>
            <button class="btn-admin btn-edit" onclick="openUsuarioModal('edit', ${u.id})">Editar</button>
            <button class="btn-admin btn-delete" onclick="deleteUsuario(${u.id})">Eliminar</button>
          </td>
        </tr>
      `;
    }).join('');
  }

  let isEditingUsuario = false;
  function openUsuarioModal(mode, id = null) {
    isEditingUsuario = (mode === 'edit');
    document.getElementById('usuarioModalTitle').textContent = isEditingUsuario ? 'Editar Usuario' : 'Nuevo Usuario';
    if (isEditingUsuario) {
      const u = currentUsuarios.find(user => user.id === id);
      document.getElementById('usuario_id').value = u.id;
      document.getElementById('usr_nombre').value = u.nombre;
      document.getElementById('usr_apellidos').value = u.apellidos;
      document.getElementById('usr_email').value = u.email;
      document.getElementById('usr_telefono').value = u.telefono;
      document.getElementById('usr_rol').value = u.rol || 'user';
      document.getElementById('usr_password').value = '';
    } else {
      document.getElementById('usuarioForm').reset();
      document.getElementById('usr_rol').value = 'user';
      document.getElementById('usuario_id').value = '';
    }
    document.getElementById('usuarioModal').classList.add('active');
  }

  function closeUsuarioModal() { document.getElementById('usuarioModal').classList.remove('active'); }

  document.getElementById('usuarioForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = {
      nombre: document.getElementById('usr_nombre').value,
      apellidos: document.getElementById('usr_apellidos').value,
      email: document.getElementById('usr_email').value,
      telefono: document.getElementById('usr_telefono').value,
      rol: document.getElementById('usr_rol').value,
      password: document.getElementById('usr_password').value
    };
    const id = document.getElementById('usuario_id').value;
    const url = isEditingUsuario ? `/api/admin/usuarios/${id}` : '/api/admin/usuarios';
    const method = isEditingUsuario ? 'PUT' : 'POST';
    
    const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    const result = await res.json();
    if (result.success) { closeUsuarioModal(); loadUsuarios(); } else { alert(result.error); }
  });

  async function deleteUsuario(id) {
    if (confirm('¿Eliminar este usuario de forma permanente?')) {
      const res = await fetch(`/api/admin/usuarios/${id}`, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) loadUsuarios(); else alert(result.error);
    }
  }

  async function loadStats() {
    try {
      const res = await fetch('/api/admin/stats');
      const stats = await res.json();
      document.getElementById('dash-usuarios').textContent = stats.usuarios || 0;
      document.getElementById('dash-reservas').textContent = stats.reservas || 0;
      document.getElementById('dash-viajes').textContent = stats.viajes || 0;
      document.getElementById('dash-ingresos').textContent = 'S/ ' + parseFloat(stats.ingresos || 0).toFixed(2);
    } catch (e) {
      console.error('Error cargando estadisticas:', e);
    }
  }

  loadViajes();
  loadStats();
</script>


</body>
</html>
