<!DOCTYPE html>
<html lang="es">
<%- include('partials/head') %>
<body style="background: var(--cream);">

<!-- HEADER MINIMALISTA -->
<header style="background: #fff; padding: 15px 0; border-bottom: 1px solid var(--line); box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
  <div class="container" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
    
    <!-- LADO IZQUIERDO: Logo -->
    <a href="/" style="font-family: var(--font-display); font-weight: 800; font-size: 24px; color: var(--navy); text-decoration: none;">
      VISION<span style="color:#B2D235;">21</span>
    </a>

    <!-- LADO DERECHO: Avatar, Mis Reservas, Volver -->
    <div style="display: flex; align-items: center; justify-content: flex-end; gap: 20px;">
      <a href="/mis-reservas" class="btn" style="padding: 10px 16px; background: #FF1A1A; color: #fff; font-weight: 800; border-radius: 8px; border: none; box-shadow: 0 4px 10px rgba(255,26,26,0.3); text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.5px; text-decoration: none;">
        Mis Reservas
      </a>
      <a href="/" style="color: var(--mist); text-decoration: none; font-size: 14px; font-weight: 600;">← Volver al inicio</a>
      <% if (locals.usuario) { %>
        <div style="display: flex; align-items: center; gap: 12px; padding-left: 15px; border-left: 2px solid #e2e8f0;">
          <div style="width: 40px; height: 40px; border-radius: 50%; background: #f8fafc; color: #0f172a; border: 2px solid #B2D235; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 18px; box-shadow: 0 2px 8px rgba(178, 210, 53, 0.3);">
            <%= locals.usuario.nombre.charAt(0).toUpperCase() %>
          </div>
          <span style="font-size: 15px; font-weight: 700; color: #1e293b;"><%= locals.usuario.nombre %></span>
        </div>
      <% } %>
    </div>

  </div>
</header>

<main style="width: 100%; padding: 40px 20px; box-sizing: border-box;">
  
  <!-- PROGRESS BAR -->
  <div class="wizard-progress">
    <div class="step active" id="step1-indicator">
      <div class="step-circle">1</div>
      <span>Horario</span>
    </div>
    <div class="step-line"></div>
    <div class="step" id="step2-indicator">
      <div class="step-circle">2</div>
      <span>Asientos</span>
    </div>
    <div class="step-line"></div>
    <div class="step" id="step3-indicator">
      <div class="step-circle">3</div>
      <span>Pasajero y Pago</span>
    </div>
  </div>

  <div class="wizard-container">
    
    <!-- PASO 1: SELECCIÓN DE HORARIO -->
    <div id="step-1" class="wizard-step active">
      <div class="step-header">
        <h2>Selecciona tu horario</h2>
        <p style="font-size: 1.15rem; background: #f4f9e3; color: var(--navy); padding: 12px 20px; border-radius: 8px; display: inline-block; margin-top: 10px; font-weight: 500; border: 1px solid #B2D235;">Ruta: <strong id="route-origen"><%= origen %></strong> a <strong id="route-destino"><%= destino %></strong> &nbsp;|&nbsp; Fecha: <strong id="route-fecha"><%= fecha %></strong></p>
      </div>
      
      <div id="buses-list" class="buses-list">
        <p style="text-align: center; color: var(--mist); padding: 40px;">Cargando horarios disponibles...</p>
      </div>
    </div>

    <!-- PASO 2: PREFERENCIAS DE VIAJE -->
    <div id="step-2" class="wizard-step">
      <div class="step-header">
        <h2>Preferencias de Viaje</h2>
        <p>Indícanos cuántas personas viajan y dónde prefieren sentarse.</p>
      </div>
      
      <div class="seat-selection-layout">
        <!-- Opciones de Ubicación -->
        <div class="bus-container" style="padding: 30px; text-align: left; background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
          
          <div class="field-group" style="margin-bottom: 25px; display: flex; gap: 15px;">
            <div style="flex: 1;">
              <label style="font-weight: 700; color: var(--navy); display: block; margin-bottom: 10px; font-size: 1.1rem;">Adultos</label>
              <select id="step2-qty-adults" style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 1rem; color: var(--navy); font-weight: 600;">
                <option value="1">1 Persona</option>
                <option value="2">2 Personas</option>
                <option value="3">3 Personas</option>
                <option value="4">4 Personas</option>
                <option value="5">5 Personas</option>
              </select>
            </div>
            <div style="flex: 1;">
              <label style="font-weight: 700; color: var(--navy); display: block; margin-bottom: 10px; font-size: 1.1rem;">Niños (<11 años)</label>
              <select id="step2-qty-children" style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 1rem; color: var(--navy); font-weight: 600;">
                <option value="0">0 Niños</option>
                <option value="1">1 Niño (50% dscto)</option>
                <option value="2">2 Niños (50% dscto)</option>
                <option value="3">3 Niños (50% dscto)</option>
                <option value="4">4 Niños (50% dscto)</option>
              </select>
            </div>
          </div>

          <div class="field-group">
            <label style="font-weight: 700; color: var(--navy); display: block; margin-bottom: 10px; font-size: 1.1rem;">Ubicación Preferida</label>
            <div style="display: flex; flex-direction: column; gap: 15px;">
              <label class="loc-label" style="display: flex; align-items: center; gap: 12px; padding: 15px; border: 2px solid #B2D235; border-radius: 8px; cursor: pointer; transition: all 0.2s; background: #f4f9e3;">
                <input type="radio" name="ubicacion" value="Adelante" checked style="transform: scale(1.2);">
                <div>
                  <strong style="display: block; color: var(--navy); font-size: 1.05rem;">Adelante (Copiloto)</strong>
                  <span style="font-size: 0.85rem; color: var(--mist);">Asientos junto al chofer.</span>
                </div>
              </label>
              
              <label class="loc-label" style="display: flex; align-items: center; gap: 12px; padding: 15px; border: 1px solid #cbd5e1; border-radius: 8px; cursor: pointer; transition: all 0.2s;">
                <input type="radio" name="ubicacion" value="Atrás">
                <div>
                  <strong style="display: block; color: var(--navy); font-size: 1.05rem;">Atrás (Cabina Principal)</strong>
                  <span style="font-size: 0.85rem; color: var(--mist);">Ubicación en la parte posterior del bus.</span>
                </div>
              </label>
            </div>
          </div>

        </div>
        
        <!-- Resumen Lateral -->
        <div class="seat-summary">
          <h3>Resumen</h3>
          
          <div class="selected-seats-info" style="margin-top: 15px; margin-bottom: 20px;">
            <p style="margin-bottom: 5px; color: var(--mist);">Pasajeros:</p>
            <div id="summary-qty" style="font-weight: 800; color: var(--navy); font-size: 1.2rem;">1 Persona</div>
          </div>

          <div class="selected-seats-info" style="margin-bottom: 25px;">
            <p style="margin-bottom: 5px; color: var(--mist);">Ubicación:</p>
            <div id="summary-loc" style="font-weight: 800; color: var(--navy); font-size: 1.2rem;">Adelante</div>
          </div>
          
          <div class="total-price">
            Total: <span>S/ <span id="total-amount">0.00</span></span>
          </div>
          
          <button class="btn btn-primary" id="btn-next-step2" style="width: 100%; margin-top: 20px;">
            Continuar
          </button>
          <button class="btn btn-ghost" id="btn-back-step2" style="width: 100%; margin-top: 10px;">
            Volver a horarios
          </button>
        </div>
      </div>
    </div>

    <!-- PASO 3: DATOS DEL PASAJERO Y PAGO -->
    <div id="step-3" class="wizard-step">
      <div class="step-header">
        <h2>Detalles del Pasajero y Pago</h2>
        <p>Completa la información para confirmar tu reserva.</p>
      </div>
      
      <div class="checkout-layout">
        <div class="passenger-form">
          <div id="passenger-fields-container">
            <!-- Formularios de pasajeros generados dinámicamente -->
          </div>
          
          <h3 style="margin-top: 30px; margin-bottom: 15px;">Datos de Contacto</h3>
          <div class="field-group">
            <label>Correo Electrónico</label>
            <input type="email" id="contact-email" value="<%= locals.usuario ? locals.usuario.email : '' %>" placeholder="ejemplo@correo.com" required>
          </div>
          <div class="field-group">
            <label>Celular</label>
            <input type="tel" id="contact-phone" value="<%= locals.usuario && locals.usuario.telefono ? locals.usuario.telefono : '' %>" placeholder="987654321" pattern="[0-9]{9,15}" minlength="9" maxlength="15" title="Ingrese un número de teléfono válido" required oninput="this.value = this.value.replace(/[^0-9]/g, '')">
          </div>
        </div>
        
        <div class="checkout-summary">
          <h3>Tu Viaje</h3>
          <p><strong>Ruta:</strong> <%= origen %> - <%= destino %></p>
          <p><strong>Fecha:</strong> <%= fecha %></p>
          <p><strong>Hora:</strong> <span id="summary-time"></span></p>
          <p><strong>Servicio:</strong> <span id="summary-service"></span></p>
          <hr style="margin: 15px 0; border: none; border-top: 1px dashed var(--line);">
          
          <!-- CUPÓN DE DESCUENTO -->
          <div style="margin-bottom: 15px; background: #f8fafc; padding: 15px; border-radius: 8px; border: 1px solid #cbd5e1;">
            <label style="font-weight: 700; color: var(--navy); font-size: 0.9rem; display: block; margin-bottom: 8px;">¿Tienes un código de descuento?</label>
            <div style="display: flex; gap: 10px;">
              <input type="text" id="coupon-code" placeholder="Ej: FAMILIA15" style="flex: 1; text-transform: uppercase; padding: 10px; border-radius: 6px; border: 1px solid #cbd5e1; font-weight: 700;">
              <button class="btn" id="btn-apply-coupon" style="background: var(--navy); color: white; padding: 0 15px; border-radius: 6px; border: none; font-weight: 700;">Aplicar</button>
            </div>
            <p id="coupon-message" style="margin-top: 8px; font-size: 0.85rem; font-weight: 600; display: none;"></p>
          </div>

          <div class="total-price" style="display: flex; justify-content: space-between; align-items: center;">
            A Pagar: 
            <div style="text-align: right;">
              <span id="original-amount" style="text-decoration: line-through; color: var(--mist); font-size: 1rem; display: none; margin-right: 10px;">S/ 0.00</span>
              <span>S/ <span id="final-amount">0.00</span></span>
            </div>
          </div>
          
          <button class="btn btn-primary" id="btn-open-payment" style="width: 100%; margin-top: 20px; background-color: #6C197F; border-color: #6C197F; font-size: 1.1rem; box-shadow: 0 4px 15px rgba(108, 25, 127, 0.4);">
            Pagar con Yape
          </button>
          <button class="btn btn-ghost" id="btn-back-step3" style="width: 100%; margin-top: 10px;">
            Volver a asientos
          </button>
        </div>
      </div>
    </div>

    <!-- MODAL YAPE -->
    <div id="yape-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 9999; justify-content: center; align-items: center;">
      <div style="background: #fff; width: 90%; max-width: 400px; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.2);">
        <div style="background: #6C197F; padding: 20px; text-align: center; color: white;">
          <h3 style="margin: 0; font-size: 1.5rem; font-weight: 800; letter-spacing: 1px;">YAPE</h3>
        </div>
        <div style="padding: 30px 20px; text-align: center;">
          <p style="color: var(--mist); margin-bottom: 5px;">Escanea este código para pagar</p>
          <h2 style="color: var(--navy); font-size: 2.2rem; margin-bottom: 20px;">S/ <span id="yape-amount">0.00</span></h2>
          
          <div style="width: 200px; height: 200px; margin: 0 auto 20px; background: #f1f5f9; border: 2px dashed #cbd5e1; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
             <!-- Placeholder para QR. Puedes subir tu QR en /imagenes/yape-qr-ejemplo.png -->
             <img src="/imagenes/yape-qr-ejemplo.png" onerror="this.src='https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=YAPE-VISION21'" alt="QR Yape" style="width: 100%; height: 100%; border-radius: 12px; object-fit: cover;">
          </div>

          <p style="color: #0f172a; font-weight: 700; margin-bottom: 20px;">A nombre de: VISION 21 S.A.C.<br>Celular: 999 999 999</p>
          
          <div style="margin-bottom: 20px; text-align: left;">
            <label for="yape-operacion" style="font-weight: 700; color: var(--navy); font-size: 0.9rem; margin-bottom: 5px; display: block;">Número de Operación Yape</label>
            <input type="text" id="yape-operacion" placeholder="Ej: 12345678" style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-weight: 600; font-size: 1.1rem; text-align: center;">
          </div>

          <button id="btn-yape-confirm" style="width: 100%; background: #059669; color: white; border: none; padding: 14px; border-radius: 8px; font-weight: 800; font-size: 1.1rem; cursor: pointer; transition: background 0.2s; box-shadow: 0 4px 15px rgba(5, 150, 105, 0.3);">
            Confirmar Pago
          </button>
          
          <div id="yape-loading" style="display: none; margin-top: 15px; color: var(--navy); font-weight: 700;">
            <svg style="animation: spin 1s linear infinite; width: 24px; height: 24px; margin-bottom: -6px; margin-right: 8px;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            Validando Operación...
          </div>
          <style>@keyframes spin { 100% { transform: rotate(360deg); } }</style>
        </div>
        <button id="btn-close-yape" style="width: 100%; padding: 12px; background: #f8fafc; border: none; border-top: 1px solid #e2e8f0; color: var(--mist); font-weight: 600; cursor: pointer;">Cancelar</button>
      </div>
    </div>

    <!-- PASO 4: ÉXITO -->
    <div id="step-4" class="wizard-step" style="padding: 40px 20px;">
      <div style="text-align: center; margin-bottom: 30px;">
        <div style="width: 70px; height: 70px; background: #E8F5E9; color: #2E7D32; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px;">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <h2 style="color: #2E7D32; font-size: 24px; font-weight: 800;">¡Reserva Confirmada!</h2>
        <p style="color: var(--mist);">Tu viaje está programado con éxito. Aquí tienes tu boleto digital.</p>
      </div>

      <!-- BOARDING PASS -->
      <div style="max-width: 500px; margin: 0 auto 40px; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 15px 35px rgba(0,0,0,0.1); position: relative; border: 1px solid #e2e8f0;">
        
        <!-- Header -->
        <div style="background: var(--navy); color: #fff; padding: 25px; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <span style="font-size: 12px; opacity: 0.7; text-transform: uppercase; letter-spacing: 1px;">Boleto / Ticket</span>
            <div id="ticket-code" style="font-size: 22px; font-weight: 900; letter-spacing: 2px; color: #B2D235;">ABC-12345</div>
          </div>
          <div style="text-align: right;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#B2D235" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
        </div>

        <!-- Body -->
        <div style="padding: 25px; display: flex; flex-direction: column; gap: 20px;">
          <!-- Route -->
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed #cbd5e1; padding-bottom: 20px;">
            <div style="flex: 1;">
              <span style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600;">Origen</span>
              <div id="success-origen" style="font-size: 20px; font-weight: 800; color: var(--navy);">LIM</div>
            </div>
            <div style="padding: 0 15px; color: #cbd5e1;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
            <div style="flex: 1; text-align: right;">
              <span style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600;">Destino</span>
              <div id="success-destino" style="font-size: 20px; font-weight: 800; color: var(--navy);">HUA</div>
            </div>
          </div>

          <!-- Info Grid -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
            <div>
              <span style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600;">Pasajero</span>
              <div id="success-pasajero" style="font-size: 15px; font-weight: 700; color: var(--navy); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">-</div>
            </div>
            <div>
              <span style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600;">Documento</span>
              <div id="success-documento" style="font-size: 15px; font-weight: 700; color: var(--navy);">00000000</div>
            </div>
            <div>
              <span style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600;">Fecha y Hora</span>
              <div id="success-time" style="font-size: 15px; font-weight: 700; color: var(--navy);">01/01/2026 | 00:00</div>
            </div>
            <div>
              <span style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600;">Servicio</span>
              <div id="success-servicio" style="font-size: 15px; font-weight: 700; color: var(--navy);">VIP</div>
            </div>
          </div>
        </div>
        
        <!-- Stub (barcode area) -->
        <div style="background: #f8fafc; padding: 20px 25px; border-top: 1px dashed #cbd5e1; text-align: center;">
          <div style="display: inline-block; padding: 10px; background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 10px;">
            <!-- Simple barcode simulation -->
            <div style="display: flex; height: 40px; align-items: stretch; gap: 2px;">
              <div style="width:3px; background:#0f172a;"></div><div style="width:1px; background:#0f172a;"></div><div style="width:4px; background:#0f172a;"></div>
              <div style="width:2px; background:#0f172a;"></div><div style="width:5px; background:#0f172a;"></div><div style="width:1px; background:#0f172a;"></div>
              <div style="width:3px; background:#0f172a;"></div><div style="width:2px; background:#0f172a;"></div><div style="width:4px; background:#0f172a;"></div>
              <div style="width:1px; background:#0f172a;"></div><div style="width:3px; background:#0f172a;"></div><div style="width:4px; background:#0f172a;"></div>
              <div style="width:2px; background:#0f172a;"></div><div style="width:3px; background:#0f172a;"></div><div style="width:1px; background:#0f172a;"></div>
              <div style="width:5px; background:#0f172a;"></div><div style="width:2px; background:#0f172a;"></div><div style="width:3px; background:#0f172a;"></div>
              <div style="width:2px; background:#0f172a;"></div><div style="width:4px; background:#0f172a;"></div><div style="width:1px; background:#0f172a;"></div>
              <div style="width:3px; background:#0f172a;"></div><div style="width:2px; background:#0f172a;"></div><div style="width:4px; background:#0f172a;"></div>
            </div>
          </div>
          <div style="font-size: 12px; color: #94a3b8; font-family: monospace;" id="success-barcode-text">TICKET-123</div>
        </div>

        <!-- Cutout effect circles -->
        <div style="position: absolute; left: -10px; bottom: 125px; width: 20px; height: 20px; background: #F4F6F8; border-radius: 50%; box-shadow: inset -1px 0 2px rgba(0,0,0,0.05);"></div>
        <div style="position: absolute; right: -10px; bottom: 125px; width: 20px; height: 20px; background: #F4F6F8; border-radius: 50%; box-shadow: inset 1px 0 2px rgba(0,0,0,0.05);"></div>
      </div>
      <!-- END BOARDING PASS -->

      <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
        <button id="btn-print-voucher" class="btn" style="background-color: #0f172a; color: white; padding: 14px 28px; border-radius: 8px; font-weight: 700; border: none; cursor: pointer; display: flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Descargar PDF
        </button>
        <a href="https://wa.me/51930977607" target="_blank" class="btn" style="padding: 14px 28px; background-color: #25D366; border-color: #25D366; color: white; border-radius: 8px; font-weight: 700; display: flex; align-items: center; gap: 8px;">
          WhatsApp
        </a>
        <a href="/mis-reservas" class="btn" style="padding: 14px 28px; background: #fff; color: var(--navy); border: 1px solid #cbd5e1; border-radius: 8px; font-weight: 700;">Ver mis viajes</a>
      </div>
    </div>

  </div>
</main>

<%- include('partials/scripts') %>
<script>
  window.USER_DATA = {
    nombre: "<%= locals.usuario ? (locals.usuario.nombre + ' ' + locals.usuario.apellidos).trim() : '' %>"
  };
</script>
<script src="/scripts/reservas.js"></script>
</body>
</html>
