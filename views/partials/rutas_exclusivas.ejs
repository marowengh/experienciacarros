        position: relative;
        overflow: hidden;
      }
      .rutas-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 4px; height: 100%;
        background: #B2D235;
        box-shadow: 0 0 15px #B2D235;
        opacity: 0;
        transition: opacity 0.4s;
