<!-- ================= BUSCADOR COCKPIT ================= -->
<div class="container search-wrap" id="pasaje">
  <div class="search-card futuristic">
    <div class="sc-image" style="background-image: url('/imagenes/premium_traveler.jpg');">
      <div class="sc-image-overlay">
        <div class="sc-tech-tag">SISTEMA INTELIGENTE DE RUTAS</div>
        <h3>Conexiones Directas desde Ayacucho</h3>
        <p>Unidades ejecutivas de última generación con monitoreo en vivo.</p>
      </div>
    </div>
    <div class="sc-content">
      <div class="sc-title">
        <div class="sc-icon-glow">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <span>Cotización Inmediata por WhatsApp</span>
      </div>
      
      <form id="search-wa-form" class="search-grid" onsubmit="buscarPasajeWhatsApp(event)">
        <div class="field">
          <label for="origen">Punto de Origen</label>
          <div class="input-row cyber-input">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.6 7-12a7 7 0 1 0-14 0c0 5.4 7 12 7 12z"/><circle cx="12" cy="9" r="2.6"/></svg>
            <select name="origen" id="origen">
              <option value="Ayacucho">Ayacucho — Hub Central</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="destino">Nodo de Destino</label>
          <div class="input-row cyber-input">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.6 7-12a7 7 0 1 0-14 0c0 5.4 7 12 7 12z"/><circle cx="12" cy="9" r="2.6"/></svg>
            <select name="destino" id="destino">
              <option value="Lima">Lima (Capital)</option>
              <option value="Huanta">Huanta</option>
              <option value="Abancay">Abancay</option>
              <option value="Cusco">Cusco</option>
              <option value="Ica">Ica</option>
              <option value="Arequipa">Arequipa</option>
              <option value="San Miguel">San Miguel</option>
              <option value="La Mar">La Mar</option>
              <option value="VRAE">VRAEM</option>
              <option value="Cangallo">Cangallo</option>
              <option value="Vinchos">Vinchos</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="fecha">Fecha Estimada de Salida</label>
          <div class="input-row cyber-input">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            <input type="date" name="fecha" id="fecha">
          </div>
        </div>

        <button type="submit" class="btn btn-cyber-launch">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.52 3.48A11.93 11.93 0 0 0 12.07 0C5.46 0 .08 5.38.08 12c0 2.11.55 4.18 1.6 6.01L0 24l6.19-1.62A11.9 11.9 0 0 0 12.07 24c6.61 0 12-5.38 12-12 0-3.21-1.25-6.23-3.55-8.52zM12.07 22c-1.8 0-3.56-.48-5.11-1.39l-.37-.22-3.8 1 1.01-3.7-.24-.38A9.95 9.95 0 0 1 2.08 12c0-5.51 4.48-10 10-10 2.67 0 5.18 1.04 7.07 2.93A9.93 9.93 0 0 1 22.07 12c0 5.51-4.48 10-10 10zm5.49-7.46c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.95 1.18-.18.2-.35.23-.65.08-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.79-1.68-2.09-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.68-1.64-.93-2.25-.24-.6-.49-.52-.68-.53h-.58c-.2 0-.53.08-.8.38-.28.3-1.05 1.03-1.05 2.51s1.08 2.91 1.23 3.11c.15.2 2.13 3.25 5.16 4.56.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.31.18-1.43-.08-.13-.28-.2-.58-.35z"/></svg>
          <span>Consultar Disponibilidad por WhatsApp</span>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
function buscarPasajeWhatsApp(e) {
  e.preventDefault();
  const origen = document.getElementById('origen').value;
  const destino = document.getElementById('destino').value;
  const fecha = document.getElementById('fecha').value;
  const fechaTxt = fecha ? ' para la fecha ' + fecha : '';
  const msg = encodeURIComponent('Hola Vision 21, deseo consultar disponibilidad y comprar pasaje para la ruta ' + origen + ' hacia ' + destino + fechaTxt + '. ¿Me brindan los horarios y tarifas?');
  window.open('https://wa.me/51930977607?text=' + msg, '_blank');
}
</script>