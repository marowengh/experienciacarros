<!-- ================= HEADER ================= -->
<% if (locals.usuario && !locals.usuario.telefono) { %>
  <div style="background: #fef2f2; color: #b91c1c; text-align: center; padding: 10px; font-weight: 500; font-size: 14px; border-bottom: 1px solid #fecaca; width: 100%; z-index: 9999; position: relative;">
    Faltan datos en tu cuenta. <a href="/perfil" style="color: #b91c1c; font-weight: 700; text-decoration: underline;">Configura tu cuenta aquí</a>.
  </div>
<% } %>
<header>
  <div class="nav-wrap" style="width: 100%; padding: 14px 10px;">
    <a href="/#inicio" class="logo">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h13l3 4H3z"/><path d="M16 8l3 4"/><circle cx="7" cy="18" r="1.6" fill="#fff" stroke="none"/><circle cx="16" cy="18" r="1.6" fill="#fff" stroke="none"/><path d="M3 8h11v4H3z"/></svg>
      </span>
      <span>VISION <em>21</em><small>Ayacucho · Perú</small></span>
    </a>

    <nav class="main-nav">
      <ul>
        <li><a href="/#inicio">Inicio</a></li>
        <li><a href="/#destinos">Destinos</a></li>
        <li><a href="/#servicios">Servicios</a></li>
        <li><a href="/#pasaje">Comprar Pasaje</a></li>
        <li><a href="/#contacto">Contacto</a></li>
      </ul>
    </nav>

    <div class="header-cta" style="display: flex; gap: 10px;">
      <a href="#" class="btn btn-outline-navy" style="padding:10px 16px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
        Rastrear
      </a>
      
      <% if (locals.usuario) { %>
        <div class="user-dropdown-container" style="position: relative; display: inline-block;">
          <div style="display: flex; align-items: center; gap: 12px; padding-right: 15px; cursor: pointer; margin-right: 5px; border-right: 2px solid #e2e8f0;" id="userDropdownTrigger">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: #f8fafc; color: #0f172a; border: 2px solid #B2D235; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 18px; box-shadow: 0 2px 8px rgba(178, 210, 53, 0.3);">
              <%= locals.usuario.nombre.charAt(0).toUpperCase() %>
            </div>
            <span style="font-size: 15px; font-weight: 700; color: #1e293b;"><%= locals.usuario.nombre %></span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </div>
          <div class="user-dropdown-menu" id="userDropdownMenu" style="display: none; position: absolute; right: 0; top: 100%; background: #fff; box-shadow: 0 10px 25px rgba(0,0,0,0.1); border-radius: 8px; min-width: 220px; padding: 10px 0; z-index: 1000; margin-top: 10px; border: 1px solid #e2e8f0;">
            <a href="/perfil" class="dropdown-item" style="display: block; padding: 10px 20px; color: #334155; font-weight: 600; text-decoration: none; transition: background 0.2s;">Mi Perfil / Configurar</a>
            <a href="/mis-reservas" class="dropdown-item" style="display: block; padding: 10px 20px; color: #334155; font-weight: 600; text-decoration: none; transition: background 0.2s;">Mis Reservas</a>
            <% if (locals.usuario.rol === 'admin' || locals.usuario.email === 'marowengonzaleshl@gmail.com' || locals.usuario.email === 'admin@vision21.com' || locals.usuario.email === 'gerente@vision21.com') { %>
              <a href="/admin" class="dropdown-item" style="display: block; padding: 10px 20px; color: #334155; font-weight: 600; text-decoration: none; transition: background 0.2s;">Panel de Administración</a>
            <% } %>
            <div style="border-top: 1px solid #e2e8f0; margin: 5px 0;"></div>
            <a href="/api/logout" class="dropdown-item" style="display: block; padding: 10px 20px; color: #ef4444; font-weight: 600; text-decoration: none; transition: background 0.2s;">Cerrar Sesión</a>
          </div>
        </div>
        <script>
          const userDropdownTrigger = document.getElementById('userDropdownTrigger');
          const userDropdownMenu = document.getElementById('userDropdownMenu');
          if(userDropdownTrigger) {
            userDropdownTrigger.addEventListener('click', (e) => {
              e.stopPropagation();
              userDropdownMenu.style.display = userDropdownMenu.style.display === 'block' ? 'none' : 'block';
            });
            document.addEventListener('click', (e) => {
              if(!userDropdownTrigger.contains(e.target) && !userDropdownMenu.contains(e.target)) {
                userDropdownMenu.style.display = 'none';
              }
            });
            const links = userDropdownMenu.querySelectorAll('.dropdown-item');
            links.forEach(link => {
              link.addEventListener('mouseenter', () => link.style.background = '#f1f5f9');
              link.addEventListener('mouseleave', () => link.style.background = 'transparent');
            });
          }
        </script>
      <% } else { %>
        <a href="/login" class="btn" style="padding:10px 16px; background: #B2D235; color: #fff; font-weight: bold;">
          Iniciar Sesión
        </a>
      <% } %>
    </div>

    <button class="burger" id="burgerBtn" aria-label="Abrir menú">
      <svg viewBox="0 0 24 24" fill="none" stroke="#0A3D91" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </div>
</header>

<!-- WHATSAPP TICKER -->
<style>
  .whatsapp-ticker {
    background: #000;
    border-bottom: 1px solid rgba(37, 211, 102, 0.3);
    height: 24px;
    display: flex;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 99;
    box-shadow: 0 2px 10px rgba(37, 211, 102, 0.1);
  }
  .whatsapp-ticker-content {
    display: flex;
    align-items: center;
    gap: 15px;
    font-family: var(--font-mono), 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  .whatsapp-ticker a {
    color: #25D366;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    transition: all 0.3s ease;
  }
  .whatsapp-ticker a:hover {
    color: #fff;
    text-shadow: 0 0 8px rgba(37, 211, 102, 0.8);
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: #25D366;
    border-radius: 50%;
    box-shadow: 0 0 8px #25D366;
    animation: pulse-glow 1.5s infinite;
    display: inline-block;
  }
  @keyframes pulse-glow {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(37, 211, 102, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }
  .ticker-sep {
    color: rgba(37, 211, 102, 0.4);
    font-weight: 400;
  }
</style>
<div class="whatsapp-ticker">
  <marquee behavior="scroll" direction="left" scrollamount="4" onmouseover="this.stop();" onmouseout="this.start();">
    <a href="https://wa.me/51930977607" target="_blank" class="whatsapp-ticker-content">
      <div class="pulse-dot"></div>
      <span>ATENCIÓN AL CLIENTE (WHATSAPP) : +51 930 977 607</span>
      <span class="ticker-sep">///</span>
      <span>RESERVAS Y ENCOMIENDAS</span>
      <span class="ticker-sep">///</span>
      <span>SOPORTE 24/7 EN LÍNEA</span>
    </a>
  </marquee>
</div>

<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobileMenu">
  <div class="close-row">
    <a href="/#inicio" class="logo" style="color:#fff;">
      <span class="mark" style="background:rgba(255,255,255,0.12);">
        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h13l3 4H3z"/><path d="M16 8l3 4"/><circle cx="7" cy="18" r="1.6" fill="#fff" stroke="none"/><circle cx="16" cy="18" r="1.6" fill="#fff" stroke="none"/><path d="M3 8h11v4H3z"/></svg>
      </span>
      <span>VISION <em>21</em></span>
    </a>
    <button class="close-btn" id="closeBtn" aria-label="Cerrar menú">
      <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <ul>
    <li><a href="/#inicio"><span>01</span>Inicio</a></li>
    <li><a href="/#destinos"><span>02</span>Destinos</a></li>
    <li><a href="/#servicios"><span>03</span>Servicios</a></li>
    <li><a href="/#pasaje"><span>04</span>Comprar Pasaje</a></li>
    <li><a href="/#contacto"><span>05</span>Contacto</a></li>
  </ul>
  <div class="mm-cta">
    <a href="#" class="btn btn-ghost" style="margin-bottom: 10px;">Rastrear Encomienda</a>
    <% if (locals.usuario) { %>
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px; padding: 15px; border: 1px solid #e2e8f0; border-radius: 12px; background: #fff;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: #f8fafc; color: #0f172a; border: 2px solid #B2D235; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 18px;">
          <%= locals.usuario.nombre.charAt(0).toUpperCase() %>
        </div>
        <span style="font-size: 15px; font-weight: 700; color: #1e293b;"><%= locals.usuario.nombre %></span>
      </div>
      <a href="/perfil" class="btn btn-primary" style="background: #3b82f6; color: #fff; margin-bottom: 10px;">Mi Perfil / Configurar</a>
      <a href="/mis-reservas" class="btn btn-primary" style="background: #FF1A1A; color: #fff; margin-bottom: 10px;">Mis Reservas</a>
      <% if (locals.usuario.rol === 'admin' || locals.usuario.email === 'marowengonzaleshl@gmail.com' || locals.usuario.email === 'admin@vision21.com' || locals.usuario.email === 'gerente@vision21.com') { %>
        <a href="/admin" class="btn btn-primary" style="background: #0f172a; color: #fff; margin-bottom: 10px;">Panel de Administración</a>
      <% } %>
      <a href="/api/logout" class="btn btn-primary" style="background: #F1F5F9; color: #334155;">Cerrar Sesión</a>
    <% } else { %>
      <a href="/login" class="btn btn-primary" style="background: #B2D235; color: #fff;">Iniciar Sesión</a>
    <% } %>
  </div>
</div>